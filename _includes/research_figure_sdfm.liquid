      </g>
      <g fill="none" stroke="#222222" stroke-width="1.5">
        <rect x="252" y="40" width="44" height="44"></rect>
        <rect x="252" y="90" width="44" height="44"></rect>
        <rect x="252" y="140" width="44" height="44"></rect>
        <rect x="252" y="190" width="44" height="44"></rect>
        <rect x="252" y="254" width="44" height="44" stroke-dasharray="4 3"></rect>
        <rect x="252" y="304" width="44" height="44" stroke-dasharray="4 3"></rect>
