        <rect x="36" y="90" width="44" height="44"></rect><rect x="86" y="90" width="44" height="44"></rect><rect x="136" y="90" width="44" height="44"></rect><rect x="186" y="90" width="44" height="44"></rect>
        <rect x="36" y="140" width="44" height="44"></rect><rect x="86" y="140" width="44" height="44"></rect><rect x="136" y="140" width="44" height="44"></rect><rect x="186" y="140" width="44" height="44"></rect>
        <rect x="36" y="190" width="44" height="44"></rect><rect x="86" y="190" width="44" height="44"></rect><rect x="136" y="190" width="44" height="44"></rect><rect x="186" y="190" width="44" height="44"></rect>
